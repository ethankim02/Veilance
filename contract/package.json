{
  "name": "veilance-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veilance — confidential supply-chain provenance contract for Midnight",
  "scripts": {
    "compile": "compact compile +0.31.1 --skip-zk src/veilance.compact src/managed/veilance",
    "compile:zk": "compact compile +0.31.1 src/veilance.compact src/managed/veilance",
    "compile:v2": "compact compile +0.31.1 --skip-zk src/veilance_v2.compact src/managed/veilance_v2",
    "compile:zk:v2": "compact compile +0.31.1 src/veilance_v2.compact src/managed/veilance_v2",
    "format": "compact format +0.31.1 src/veilance.compact",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run compile",
    "e2e": "tsx e2e/run.ts",
    "e2e:dry-run": "tsx e2e/run.ts --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-capabilities": "3.3.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.2.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-indexer-client": "1.2.3",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "hono": "4.13.7",
    "rxjs": "^7.8.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
