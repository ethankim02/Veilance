# Veilance Party Agent — environment. Copy to .env.preprod (or .env.<network>) and
# load it before starting: `set -a && . ./.env.preprod && set +a && npm run dev`.
# Nothing loads this file automatically; variables are read from process.env in
# contract/e2e/lib/config.ts (VEILANCE_*) and agent/src/config.ts (PORT, CORS_ORIGIN).
# Unset = local devnet defaults (network "undeployed", localhost endpoints).

# Network: undeployed | preview | preprod | mainnet
VEILANCE_NETWORK_ID=preprod
VEILANCE_NODE_URL=https://rpc.preprod.midnight.network
VEILANCE_NODE_WS_URL=wss://rpc.preprod.midnight.network
VEILANCE_INDEXER_HTTP_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VEILANCE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# The proof server always runs locally (it sees witness data).
VEILANCE_PROOF_SERVER_URL=http://127.0.0.1:6300

# 64-hex seed of the faucet-funded wallet that pays fees. NEVER commit a real value.
# Print its address with `npx tsx src/cli/addresses.ts`, fund it at the network faucet.
VEILANCE_FUNDER_SEED=
# 1 = all parties pay fees from the funder wallet (default on public networks).
VEILANCE_SHARED_FEE_WALLET=1
# STAR per party when SHARED_FEE_WALLET=0 (10^6 STAR = 1 NIGHT).
VEILANCE_FUNDING_AMOUNT=200000000

# Agent process
PORT=4001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 0 = the agent owns no wallet (no sync, no checkpoints); fees are balanced and
# signed by a browser wallet connected per party. See docs/WALLET.md §8.
VEILANCE_AGENT_WALLET=1
